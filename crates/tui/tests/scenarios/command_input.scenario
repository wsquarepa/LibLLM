[setup]
size 100x30
db none
api none

[steps]
# /retry with no messages produces a deterministic warning status message
type "/retry"
key Enter
expect status_message contains "No user message"
expect status_level == Warning
expect message_count == 0

# The status message survives a short wait, then expires after 6s more
advance 2s
expect status_message contains "No user message"
advance 6s
expect status_message == null
